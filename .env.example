# Copy to .env and configure your preferred LLM provider.
# Keep the real .env out of version control.
LLM_BACKEND=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Local ChatGPT-authenticated Codex CLI (for trusted manual tests):
# Set LLM_BACKEND=codex_cli; no OpenAI API key needed.
LLM_CODEX_TIMEOUT_SECONDS=180
LLM_CODEX_MODEL=
